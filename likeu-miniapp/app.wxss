/** LikeU 全局样式 **/

/* 主题色 */
page {
  --theme-color: #4A90D9;
  --theme-light: #E8F0FE;
  --success-color: #67C23A;
  --warning-color: #E6A23C;
  --danger-color: #F56C6C;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --bg-color: #f5f5f5;
  --card-bg: #ffffff;
  --border-color: #eeeeee;

  background-color: var(--bg-color);
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 容器 */
.page-container {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.card {
  background: var(--card-bg);
  border-radius: 16rpx;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 文字溢出省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 垂直居中 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 按钮通用 */
.btn-primary {
  background: linear-gradient(135deg, var(--theme-color), #6BA3E0);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
}

/* 章节标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 30rpx 30rpx 20rpx;
}

/* 空状态容器 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-light);
  font-size: 28rpx;
}