/* 首页样式 */

/* 用户头部 */
.user-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4A90D9, #6BA3E0);
  padding: 60rpx 30rpx 40rpx;
  color: #fff;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
}

.user-desc {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

/* 统计卡片 */
.stats-card {
  margin-top: -30rpx;
  position: relative;
  z-index: 10;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--theme-color);
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.stats-progress {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.progress-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* 词书卡片 */
.book-card {
  cursor: pointer;
}

.book-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.book-label {
  font-size: 26rpx;
  color: var(--text-light);
}

.book-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.book-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
}

/* 操作按钮区 */
.action-section {
  padding: 0 30rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.action-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.action-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.learn-btn {
  background: linear-gradient(135deg, #4A90D9, #6BA3E0);
}

.review-btn {
  background: linear-gradient(135deg, #67C23A, #85D65A);
}

.review-btn.disabled {
  background: #ccc;
}