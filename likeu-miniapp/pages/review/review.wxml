<view class="page-container">
  <!-- 加载 -->
  <view class="empty-container" wx:if="{{loading}}">
    <van-loading />
    <text style="margin-top: 20rpx;">加载中...</text>
  </view>

  <!-- 无待复习 -->
  <van-empty
    wx:elif="{{!loading && wordList.length === 0}}"
    description="今日暂无待复习单词"
  >
    <van-button type="primary" size="small" bindtap="backHome">返回首页</van-button>
  </van-empty>

  <!-- 复习卡片 -->
  <view class="review-content" wx:elif="{{currentWord}}">
    <!-- 复习进度 -->
    <view class="progress-header">
      <text class="progress-text">复习 {{currentIndex + 1}} / {{wordList.length}}</text>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressPercent}}%"></view>
      </view>
    </view>

    <!-- 单词卡片 (复用学习页布局) -->
    <view class="card-container">
      <!-- 收藏入口 -->
      <view class="card-toolbar">
        <view class="fav-btn" bindtap="toggleWordFav">
          <van-icon
            name="{{isWordFav ? 'star' : 'star-o'}}"
            size="40rpx"
            color="{{isWordFav ? '#F5A623' : '#bbb'}}"
          />
          <text class="fav-text">{{isWordFav ? '已收藏' : '收藏'}}</text>
        </view>
      </view>

      <view
        class="word-card {{isFlipped ? 'flipped' : ''}}"
        bindtap="flipCard"
      >
        <view class="card-inner">
          <view class="card-front">
            <text class="word-text">{{currentWord.word}}</text>
            <text class="word-phonetic" wx:if="{{currentWord.phoneticUk}}">
              {{currentWord.phoneticUk}}
            </text>
            <text class="flip-hint">轻触卡片翻转查看释义</text>
          </view>

          <view class="card-back">
            <scroll-view scroll-y class="card-back-scroll">
              <text class="word-text-back">{{currentWord.word}}</text>
              <text class="word-phonetic-back" wx:if="{{currentWord.phoneticUk}}">{{currentWord.phoneticUk}}</text>
              <text class="word-meaning">{{currentWord.meaningCn}}</text>

              <view class="root-section" wx:if="{{currentWord.roots && currentWord.roots.length > 0}}">
                <view class="root-section-title">词根拆解</view>
                <view class="root-chips">
                  <view
                    class="root-chip"
                    wx:for="{{currentWord.roots}}"
                    wx:key="id"
                    data-root="{{item}}"
                    bindtap="goRootDetail"
                  >
                    <text class="root-chip-text">{{item.root}}</text>
                    <text class="root-chip-meaning">{{item.meaning}}</text>
                  </view>
                </view>
              </view>

              <view class="example-section" wx:if="{{currentWord.exampleEn}}">
                <view class="example-en">{{currentWord.exampleEn}}</view>
                <view class="example-cn">{{currentWord.exampleCn}}</view>
              </view>
            </scroll-view>
          </view>
        </view>
      </view>

      <!-- 掌握度按钮 -->
      <view class="action-buttons" wx:if="{{isFlipped}}">
        <view class="quality-btn btn-hard" bindtap="submitQuality" data-quality="1">
          <text class="btn-icon">😵</text>
          <text class="btn-label">不认识</text>
        </view>
        <view class="quality-btn btn-medium" bindtap="submitQuality" data-quality="3">
          <text class="btn-icon">🤔</text>
          <text class="btn-label">模糊</text>
        </view>
        <view class="quality-btn btn-easy" bindtap="submitQuality" data-quality="5">
          <text class="btn-icon">😊</text>
          <text class="btn-label">认识</text>
        </view>
      </view>
    </view>
  </view>
</view>