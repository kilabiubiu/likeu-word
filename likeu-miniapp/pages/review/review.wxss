/* 复习页样式 - 复用学习页卡片样式 */
@import "../study/study.wxss";

.review-content {
  padding: 0;
}

.card-container {
  padding: 20rpx 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.word-card {
  width: 100%;
  height: 620rpx;
  perspective: 2000rpx;
  cursor: pointer;
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  transform-style: preserve-3d;
}

.word-card.flipped .card-inner {
  transform: rotateY(180deg);
}

.card-front,
.card-back {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 24rpx;
  background: var(--card-bg);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.card-back {
  transform: rotateY(180deg);
}

.word-text {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.word-phonetic {
  font-size: 30rpx;
  color: var(--text-light);
  font-style: italic;
}

.flip-hint {
  position: absolute;
  bottom: 40rpx;
  font-size: 22rpx;
  color: #ccc;
}

.card-back-scroll {
  width: 100%;
  height: 100%;
  flex: 1;
}

.word-meaning {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--theme-color);
  margin-bottom: 24rpx;
  display: block;
}

.root-section {
  margin-bottom: 24rpx;
}

.root-section-title {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 12rpx;
}

.root-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.root-chip {
  background: var(--theme-light);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
}

.root-chip-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--theme-color);
}

.root-chip-meaning {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.example-section {
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 8rpx;
}

.example-en {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.example-cn {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.action-buttons {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  padding: 40rpx 0;
  width: 100%;
}

.quality-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 36rpx;
  border-radius: 20rpx;
  cursor: pointer;
  transition: transform 0.2s;
}

.quality-btn:active {
  transform: scale(0.95);
}

.btn-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.btn-label {
  font-size: 26rpx;
  font-weight: 500;
}

.btn-hard {
  background: #FFF0F0;
  color: #F56C6C;
}

.btn-medium {
  background: #FFF7E8;
  color: #E6A23C;
}

.btn-easy {
  background: #F0F9EB;
  color: #67C23A;
}